# ==============================================================================
# DARK Reposter Configuration
# ==============================================================================

# Telegram Configuration
TELEGRAM_BOT_TOKEN=123456789:replace_with_botfather_token
# Channel username (@your_channel) or numeric ID (-1001234567890)
TELEGRAM_CHANNEL_ID=@your_channel
# Optional: Telegram user ID for direct error/status alerts
TELEGRAM_ADMIN_CHAT_ID=

# Buffer API (GraphQL)
# Obtain your token at Buffer -> Account -> Settings -> Access & API
BUFFER_API_KEY=replace_with_buffer_api_key
# Run `python scripts/list_buffer_channels.py` to discover Organization and Channel IDs
BUFFER_ORGANIZATION_ID=replace_with_organization_id
# Publication mode: shareNow (instant publishing) or addToQueue
BUFFER_MODE=shareNow

# Connected Buffer Channel IDs (leave blank to disable platform)
BUFFER_CHANNEL_X=
BUFFER_CHANNEL_BLUESKY=
BUFFER_CHANNEL_MASTODON=
BUFFER_CHANNEL_THREADS=
BUFFER_CHANNEL_LINKEDIN=

# Media Settings
# Buffer downloads media via public URLs.
# If PUBLIC_MEDIA_BASE_URL is left empty, DARK Reposter automatically resolves direct Telegram CDN URLs!
# No static IP, domain, reverse proxy, or dynamic tunnels needed.
PUBLIC_MEDIA_BASE_URL=
MEDIA_PUBLIC_DIR=./data/public/media
MEDIA_SERVER_HOST=0.0.0.0
MEDIA_SERVER_PORT=8787
MEDIA_GROUP_WAIT_SECONDS=8

# Operational Mode
# DRY_RUN=true: test post parsing and adaptation without publishing to Buffer
# DRY_RUN=false: live publishing
DRY_RUN=false
# STRICT_MEDIA=true: abort if media URL cannot be constructed
STRICT_MEDIA=false
LOG_LEVEL=INFO

# Character Limits (per platform)
LIMIT_X=280
LIMIT_BLUESKY=300
LIMIT_MASTODON=500
LIMIT_THREADS=500
LIMIT_LINKEDIN=3000
